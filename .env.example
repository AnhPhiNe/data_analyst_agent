# Copy this file to .env for local development. Never commit real credentials.
GOOGLE_API_KEY=
# Several keys rotate automatically: GOOGLE_API_KEY=key-1,key-2 (comma-separated), or
# GEMINI_API_KEY_2=..., GEMINI_API_KEY_3=.... Each key serves up to 15 requests per minute,
# then rests 65 seconds.
TABULAR_AGENT_MODEL=gemini-3.5-flash-lite
# Whole seconds; also caps each model call inside the run budget.
TABULAR_AGENT_MODEL_TIMEOUT_SECONDS=30
TABULAR_AGENT_DATA_DIR=.data
# Optional resource limits. Unset values keep these defaults; invalid values stop startup.
# TABULAR_AGENT_MAX_FILE_BYTES=104857600
# TABULAR_AGENT_MAX_XLSX_UNCOMPRESSED_BYTES=524288000
# TABULAR_AGENT_MAX_XLSX_COMPRESSION_RATIO=100
# TABULAR_AGENT_MAX_QUERY_ROWS=10000
# TABULAR_AGENT_QUERY_TIMEOUT_SECONDS=30
# TABULAR_AGENT_DUCKDB_MEMORY_LIMIT_MB=512
# TABULAR_AGENT_PROFILE_TOP_VALUES=5
# TABULAR_AGENT_MAX_TOOL_ACTIONS=12
# TABULAR_AGENT_MAX_REPAIRS_PER_ACTION=2
# TABULAR_AGENT_TOOL_TIMEOUT_SECONDS=30
# TABULAR_AGENT_RUN_TIMEOUT_SECONDS=300
LANGGRAPH_STRICT_MSGPACK=true
